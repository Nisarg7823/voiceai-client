# Copy to .env and fill in. Never commit the real file.
# The agent's .env one directory up is used as a fallback for these values,
# so a single file at the project root can configure both processes.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional — defaults shown.
LIVEKIT_ROOM=test-room
LIVEKIT_AGENT_NAME=VoiceAIAgentInbound
TOKEN_TTL=15m
PORT=5173
